{
  "name": "jonniepeed-games-rooms",
  "main": "src/index.js",
  "compatibility_date": "2026-10-06",
  "routes": [
    { "pattern": "rooms.jonniepeed.games", "custom_domain": true }
  ],
  // Only the custom domain. No workers.dev address or preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  // One Durable Object per room. SQLite-backed, the kind the Workers Free plan allows (nothing is stored in it).
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "observability": { "enabled": true }
}
